SERVICE_NAME=investment-backend
ENVIRONMENT=dev
TARGET_MODE=external
DB_ENGINE=redis

DB_HOST=www.sunmoonai.com
DB_PORT=30446
APP_DB_NAME=0
APP_DB_USER=investment_backend
APP_DB_PASSWORD=change_me_via_secret_manager

REDIS_ADMIN_USER=default
REDIS_ADMIN_PASSWORD=change_me_via_secret_manager
REDIS_DB_INDEX=0
REDIS_AUTH_ONLY=false
# REDIS_KEY_PREFIX: space-separated patterns for ACL; quoted for bash source.
REDIS_KEY_PREFIX="investment:*"
REDIS_CHANNEL_PREFIX="investment:*"
REDIS_ACL_CATEGORY="+@read +@write +@connection +@hash +@string +@list +@set +@sortedset +@pubsub"

OUTPUT_ENV_FILE=/tmp/investment-backend-redis.env
