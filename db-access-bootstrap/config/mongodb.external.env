SERVICE_NAME=knowbench-backend
ENVIRONMENT=dev
TARGET_MODE=external
DB_ENGINE=mongodb

DB_HOST=www.sunmoonai.com
DB_PORT=27017
APP_DB_NAME=knowbench
APP_DB_USER=knowbench_backend
